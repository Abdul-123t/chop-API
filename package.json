{
  "name": "chop-api",
  "version": "0.1.0",
  "private": true,
  "description": "CHOP waitlist, email and newsletter API",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
